# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin login password (plain string, keep it long & random)
ADMIN_PASSWORD="change-me"

# Random long string used to sign the admin session cookie
ADMIN_SECRET="change-me-too-a-long-random-string"
